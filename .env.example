# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://gbmis:gbmis_dev_pass@localhost:5432/gbmis?schema=public"
DATABASE_DIRECT_URL="postgresql://gbmis:gbmis_dev_pass@localhost:5432/gbmis?schema=public"
# Connection pooling via pgBouncer (used in production)
DATABASE_POOL_URL="postgresql://gbmis:gbmis_dev_pass@localhost:6432/gbmis?schema=public&pgbouncer=true"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Keycloak (OIDC) ─────────────────────────────────────────────────────────
KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM="gb-mis"
KEYCLOAK_CLIENT_ID_WEB="gb-mis-web"
KEYCLOAK_CLIENT_SECRET_WEB="REPLACE_WITH_KEYCLOAK_CLIENT_SECRET"
KEYCLOAK_CLIENT_ID_API="gb-mis-api"
KEYCLOAK_CLIENT_SECRET_API="REPLACE_WITH_KEYCLOAK_API_CLIENT_SECRET"
# Auth.js (next-auth) secret — generate with: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET_32_CHARS"
AUTH_URL="http://localhost:3000"

# ─── Object Storage (MinIO / S3-compatible) ───────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET_ATTACHMENTS="gb-mis-attachments"
S3_BUCKET_EXPORTS="gb-mis-exports"
S3_BUCKET_BACKUPS="gb-mis-backups"
S3_BUCKET_SECONDARY_DATA="gb-mis-secondary-data"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minio_dev_pass"

# ─── Encryption ──────────────────────────────────────────────────────────────
# Column-level encryption keys for pgcrypto (base64-encoded 32-byte keys)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY_CURRENT_ID="key-2026-01"
ENCRYPTION_KEY_key_2026_01="REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY"
# Add previous keys here when rotating — never delete old keys while encrypted data exists

# ─── API ─────────────────────────────────────────────────────────────────────
API_PORT=4000
API_URL="http://localhost:4000"
# k-anonymity threshold — minimum group size for aggregate exports
K_ANONYMITY_THRESHOLD=5

# ─── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_NAME="GB MIS"
NEXT_PUBLIC_KEYCLOAK_URL="http://localhost:8080"
NEXT_PUBLIC_KEYCLOAK_REALM="gb-mis"
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID="gb-mis-web"

# ─── DHIS2 ───────────────────────────────────────────────────────────────────
# Base URL of the DHIS2 instance (typically MoH's national DHIS2 per
# the Inception decision). Trailing slash optional.
DHIS2_BASE_URL="https://dhis2.example.org"
# Personal Access Token (DHIS2 2.40+) — strongly preferred. If set,
# basic auth (USERNAME/PASSWORD) is ignored.
DHIS2_PAT=""
# Basic-auth fallback for older DHIS2 instances. Discouraged for
# production deployments.
DHIS2_USERNAME="gbmis_service"
DHIS2_PASSWORD="REPLACE_WITH_DHIS2_SERVICE_ACCOUNT_PASSWORD"
# DHIS2 UID of the Liberia root org unit. Restricts org-unit pulls so
# we don't ingest every country DHIS2 serves.
DHIS2_LIBERIA_ROOT_ID="LIBERIA_ROOT_UID"

# ─── REALISE Integration ─────────────────────────────────────────────────────
REALISE_API_BASE_URL="https://realise.example.org/api"
REALISE_API_KEY="REPLACE_WITH_REALISE_API_KEY"

# ─── Observability ───────────────────────────────────────────────────────────
# Prometheus scrapes the API's /metrics endpoint on this port.
# Defined in apps/api/src/instrumentation.ts; matched by infra/prometheus/prometheus.yml.
OBSERVABILITY_METRICS_PORT="9464"
# Optional OTLP gRPC export — leave unset to rely on the Prometheus pull endpoint only.
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
SENTRY_DSN="REPLACE_WITH_SENTRY_DSN"
SENTRY_ENVIRONMENT="development"

# ─── Notifications ───────────────────────────────────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@gb-mis.gov.lr"
# Liberian SMS gateway (configured at Inception)
SMS_GATEWAY_URL=""
SMS_GATEWAY_API_KEY=""

# ─── Environment ─────────────────────────────────────────────────────────────
NODE_ENV="development"
LOG_LEVEL="debug"
