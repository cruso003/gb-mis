{
  "name": "@gb-mis/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "openapi:generate": "pnpm build && node scripts/generate-openapi.cjs",
    "openapi:check": "pnpm build && node scripts/check-openapi-drift.cjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@gb-mis/auth": "workspace:*",
    "@gb-mis/db": "workspace:*",
    "@gb-mis/indicators": "workspace:*",
    "@gb-mis/types": "workspace:*",
    "@nestjs/bull": "^10.0.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-fastify": "^10.4.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/terminus": "^10.2.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.0",
    "@opentelemetry/exporter-prometheus": "^0.55.0",
    "@opentelemetry/resources": "^1.27.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/semantic-conventions": "^1.27.0",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "fastify": "^4.28.0",
    "ioredis": "^5.4.0",
    "jwks-rsa": "^3.1.0",
    "nestjs-pino": "^4.0.0",
    "openid-client": "^5.7.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "pino-http": "^10.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@gb-mis/eslint-config": "workspace:*",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.4.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
