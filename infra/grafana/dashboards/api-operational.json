{
  "annotations": { "list": [] },
  "description": "GB MIS API operational overview — request rate, latency, errors, and audit health. The audit panels are referenced by docs/runbooks/incident-response.md and docs/runbooks/deploy.md.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Request flow",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 1,
      "title": "HTTP request rate",
      "description": "Requests per second, grouped by HTTP method.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_request_method) (rate(http_server_request_duration_seconds_count{service=\"api\"}[5m]))",
          "legendFormat": "{{http_request_method}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "HTTP p95 latency",
      "description": "95th-percentile request latency, target < 800 ms (ARCHITECTURE.md § Performance targets).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service=\"api\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "5xx error rate (last 5 min)",
      "description": "Rollback trigger threshold per docs/runbooks/deploy.md § 8: > 5 per minute = abort and rollback.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.083 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service=\"api\",http_response_status_code=~\"5..\"}[5m]))"
        }
      ]
    },
    {
      "type": "row",
      "id": 101,
      "title": "Audit health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Audit emit rate",
      "description": "Audit emissions per second, by outcome. Per CLAUDE.md rule #8 every mutation emits — a sustained drop here is itself an incident.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(gbmis_audit_emit_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Audit emit failure rate",
      "description": "Per docs/runbooks/incident-response.md, any non-zero failure rate is investigated. Sustained > 0.1/s pages the on-call.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.001 },
              { "color": "red", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gbmis_audit_emit_total{outcome=\"error\"}[5m]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Audit emit p95 latency",
      "description": "Slow audit writes become slow user requests because the interceptor is fail-closed.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gbmis_audit_emit_latency_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["gb-mis", "operational"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "GB MIS — API Operational",
  "uid": "gbmis-api-ops",
  "version": 1,
  "weekStart": ""
}
